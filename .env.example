# ==============================================================================
# COVER LETTER CREATOR - FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Sao chép file này thành .env để cấu hình môi trường phát triển cục bộ:
#   cp .env.example .env
#
# Lưu ý: Các biến môi trường trong Vite BẮT BUỘC phải có tiền tố `VITE_`
# để có thể truy cập được ở frontend thông qua `import.meta.env.*`.
# ==============================================================================

# Backend API Endpoint (Spring Boot server, mặc định cổng 8080)
# Local: http://localhost:8080
# Production: https://your-backend-domain.com
VITE_BACKEND_URL=http://localhost:8080

# TinyMCE Rich Text Editor API Key
# Đăng ký miễn phí tại: https://www.tiny.cloud/
# Nếu không có, bạn có thể để 'no-api-key' cho chế độ dev (sẽ có thông báo watermark)
VITE_API_KEY_TINY=your_tinymce_api_key_here

# Google OAuth 2.0 Client ID
# Tạo tại Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# GitHub OAuth App Client ID
# Tạo tại GitHub -> Settings -> Developer settings -> OAuth Apps
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# (Tùy chọn) GitHub OAuth Redirect URI
# Nếu để trống, hệ thống sẽ tự động dùng: `${window.location.origin}/auth-callback`
# VITE_GITHUB_REDIRECT_URI=http://localhost:5173/auth-callback
